+/// "view:<on>,<distance>,<yawDegrees>,<panX>,<panY>,<width>,<height>" sets everything at once;
+/// "refresh" draws a new picture now; "off" stops drawing and frees the camera.
+extern "C" void companionMap3DCommand(const char* args)
+{
+    const std::string a = args != nullptr ? args : "";
+    if (a.rfind("view:", 0) == 0)
+    {
+        std::vector<std::string> fields;
+        size_t start = 5;
+        while (start <= a.size())
+        {
+            const size_t comma = a.find(',', start);
+            fields.push_back(a.substr(start, comma == std::string::npos ? std::string::npos : comma - start));
+            if (comma == std::string::npos)
+                break;
+            start = comma + 1;
+        }
+        auto field = [&](size_t i) { return i < fields.size() ? fields[i] : std::string(); };
+        sWanted.mOn = field(0) == "1";
+        sWanted.mDistance = std::clamp(parseFloat(field(1), 3000.f), 300.f, 40000.f);
+        sWanted.mYaw = parseFloat(field(2), 0.f);
+        sWanted.mPanX = parseFloat(field(3), 0.f);
+        sWanted.mPanY = parseFloat(field(4), 0.f);
+        sWanted.mWidth = std::clamp(static_cast<int>(parseFloat(field(5), 480.f)), 64, kMaxSize);
+        sWanted.mHeight = std::clamp(static_cast<int>(parseFloat(field(6), 360.f)), 64, kMaxSize);
+        sWanted.mForce = true;
+    }
+    else if (a == "refresh")
+        sWanted.mForce = true;
+    else if (a == "off")
+        sWanted.mOn = false;
+}
+
+/// Runs once a frame on the engine thread, before the frame is drawn.
+extern "C" void companionMap3DFrame()
+{
+    if (!sRetired.empty())
+        purgeRetired(nowMs());
+
+    // The camera draws in the one frame it was switched on for.
+    if (sDrewLastFrame && sNode)
+    {
+        sNode->setNodeMask(0);
+        sDrewLastFrame = false;
+    }
+
+    if (!sWanted.mOn)
+    {
+        if (sNode)
+            removeNode();
+        return;
+    }
+
+    MWBase::World* world = MWBase::Environment::get().getWorld();
+    MWBase::StateManager* state = MWBase::Environment::get().getStateManager();
+    if (world == nullptr || state == nullptr || state->getState() != MWBase::StateManager::State_Running)
+        return;
+    MWWorld::Ptr player = world->getPlayerPtr();
+    if (player.isEmpty() || player.getCell() == nullptr)
+        return;
+    MWRender::RenderingManager* rendering = world->getRenderingManager();
+    if (rendering == nullptr)
+        return;
+
+    const long long now = nowMs();
+    if (sInFlight.load())
+    {
+        if (now - sInFlightSinceMs < kInFlightTimeoutMs)
+            return;
+        sInFlight.store(false);
+    }
+    if (now - sLastRenderMs < kMinIntervalMs)
+        return;
+
+    const osg::Vec3f playerPos = player.getRefData().getPosition().asVec3();
+    const osg::Vec3f focus(playerPos.x() + sWanted.mPanX, playerPos.y() + sWanted.mPanY, playerPos.z());
+    const void* cell = player.getCell();
+    const bool interior = !player.getCell()->isExterior();
+
+    const float moveBeforeUpdate = std::max(16.f, sWanted.mDistance * 0.01f);
+    const bool changed = !sLastValid || sWanted.mForce || cell != sLastCell
+        || (focus - sLastFocus).length2() > moveBeforeUpdate * moveBeforeUpdate
+        || std::abs(sWanted.mDistance - sLastDistance) > 1.f || std::abs(sWanted.mYaw - sLastYaw) > 0.5f;
+    if (!changed)
+        return;
+
+    if (!ensureNode(rendering, sWanted.mWidth, sWanted.mHeight))
+        return;
+
+    sNode->setView(focus, sWanted.mDistance, sWanted.mYaw);
+    {
+        std::lock_guard<std::mutex> lock(sNode->mCaptureMutex);
+        sNode->mCapture.mViewProjection = sNode->getPlainViewProjection();
+        sNode->mCapture.mFocus = focus;
+        sNode->mCapture.mDistance = sWanted.mDistance;
+        sNode->mCapture.mYaw = sWanted.mYaw;
+        sNode->mCapture.mInterior = interior;
+        sNode->mCapture.mSequence = ++sSequence;
+        sNode->mArmed = true;
+    }
+    sNode->setNodeMask(MWRender::Mask_RenderToTexture);
+    sDrewLastFrame = true;
+    sInFlight.store(true);
+    sInFlightSinceMs = now;
+    sLastRenderMs = now;
+
+    sLastValid = true;
+    sLastFocus = focus;
+    sLastDistance = sWanted.mDistance;
+    sLastYaw = sWanted.mYaw;
+    sLastCell = cell;
+    sWanted.mForce = false;
+}
