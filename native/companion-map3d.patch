+// RG DS 3D local map. Called from companionmap3d.cpp's delivery thread (never the draw thread) with
+// one picture, rows top-down, and the row-major matrix that takes a world position as a row vector
+// (x, y, z, 1) to clip space. params = focus x, y, z, distance, yaw degrees, interior (0/1).
+extern "C" void companionDeliverMap3D(int width, int height, const float* viewProjection, float focusX,
+    float focusY, float focusZ, float distance, float yawDegrees, int interior, int sequence,
+    const unsigned char* rgba)
+{
+    if (!g_companionVm || !g_companionClass || !g_map3dMethod || !rgba || !viewProjection) return;
+
+    JNIEnv* e = nullptr;
+    g_companionVm->AttachCurrentThread(&e, nullptr);
+    const jsize size = static_cast<jsize>(width) * height * 4;
+    jbyteArray pixels = e->NewByteArray(size);
+    jfloatArray matrix = e->NewFloatArray(16);
+    jfloatArray params = e->NewFloatArray(6);
+    if (pixels && matrix && params)
+    {
+        e->SetByteArrayRegion(pixels, 0, size, reinterpret_cast<const jbyte*>(rgba));
+        e->SetFloatArrayRegion(matrix, 0, 16, viewProjection);
+        const float p[6] = { focusX, focusY, focusZ, distance, yawDegrees, static_cast<float>(interior) };
+        e->SetFloatArrayRegion(params, 0, 6, p);
+        e->CallStaticVoidMethod(g_companionClass, g_map3dMethod, (jint)width, (jint)height, matrix, params,
+            (jint)sequence, pixels);
+        if (e->ExceptionCheck()) { e->ExceptionDescribe(); e->ExceptionClear(); }
+    }
+    if (pixels) e->DeleteLocalRef(pixels);
+    if (matrix) e->DeleteLocalRef(matrix);
+    if (params) e->DeleteLocalRef(params);
+}
