+#include <GLES3/gl3.h>
+#endif
+
+// Defined in androidmain.cpp. Delivers one picture, rows top-down, with the matrix that takes a world
+// position (x, y, z, 1) as a row vector to clip space (OSG convention: clip = p * m, m row-major).
+extern "C" void companionDeliverMap3D(int width, int height, const float* viewProjection, float focusX,
+    float focusY, float focusZ, float distance, float yawDegrees, int interior, int sequence,
+    const unsigned char* rgba);
+
+namespace
+{
+    constexpr double kFieldOfView = 45.0;
+    constexpr double kPitch = 55.0;
+    constexpr long long kMinIntervalMs = 200;
+    // A picture in flight that never comes back (the frame was dropped) is given up after this long.
+    constexpr long long kInFlightTimeoutMs = 1500;
+    constexpr int kMaxSize = 640;
+
+    long long nowMs()
+    {
+        return std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now().time_since_epoch())
+            .count();
+    }
+
+    // What the companion asked for. Written and read on the engine thread only (commands are drained
+    // there), so it needs no lock.
+    struct Wanted
+    {
+        bool mOn = false;
+        float mDistance = 3000.f;
+        float mYaw = 0.f; // degrees, 0 = looking north
+        float mPanX = 0.f;
+        float mPanY = 0.f;
+        int mWidth = 480;
+        int mHeight = 360;
+        bool mForce = false;
+    };
+    Wanted sWanted;
+
+    // The picture being drawn: what the draw thread hands back with the pixels.
+    struct Capture
+    {
+        osg::Matrixf mViewProjection;
+        osg::Vec3f mFocus;
+        float mDistance = 0.f;
+        float mYaw = 0.f;
+        bool mInterior = false;
+        int mSequence = 0;
+    };
+
+    // Pixels waiting for the delivery thread, so the JNI call and the copy into Java never run on the
+    // draw thread.
+    struct Outbox
+    {
+        std::mutex mMutex;
+        std::condition_variable mCv;
+        bool mFull = false;
+        int mWidth = 0;
+        int mHeight = 0;
+        Capture mCapture;
+        std::vector<unsigned char> mPixels;
+        std::thread mThread;
+        bool mStarted = false;
+    };
+    Outbox sOutbox;
+
+    std::atomic<bool> sInFlight{ false };
+
+    void deliveryLoop()
+    {
+        std::vector<unsigned char> pixels;
+        for (;;)
+        {
+            int width = 0, height = 0;
+            Capture capture;
+            {
+                std::unique_lock<std::mutex> lock(sOutbox.mMutex);
+                sOutbox.mCv.wait(lock, [] { return sOutbox.mFull; });
+                pixels.swap(sOutbox.mPixels);
+                width = sOutbox.mWidth;
+                height = sOutbox.mHeight;
+                capture = sOutbox.mCapture;
+                sOutbox.mFull = false;
+            }
+            companionDeliverMap3D(width, height, capture.mViewProjection.ptr(), capture.mFocus.x(),
+                capture.mFocus.y(), capture.mFocus.z(), capture.mDistance, capture.mYaw, capture.mInterior ? 1 : 0,
+                capture.mSequence, pixels.data());
+        }
+    }
+
+    void post(int width, int height, const Capture& capture, std::vector<unsigned char>& pixels)
+    {
+        std::lock_guard<std::mutex> lock(sOutbox.mMutex);
+        if (!sOutbox.mStarted)
+        {
+            sOutbox.mThread = std::thread(deliveryLoop);
+            sOutbox.mThread.detach();
+            sOutbox.mStarted = true;
+        }
+        // A newer picture replaces one not yet delivered.
+        sOutbox.mPixels.swap(pixels);
+        sOutbox.mWidth = width;
+        sOutbox.mHeight = height;
+        sOutbox.mCapture = capture;
+        sOutbox.mFull = true;
+        sOutbox.mCv.notify_one();
+    }
+}
+
+namespace MWRender
+{
+    class CompanionMap3DRenderToTexture;
+
+    /// Reads the picture back after the camera has drawn it. Runs on the draw thread.
+    struct CompanionMap3DReadBack : public osg::Camera::DrawCallback
+    {
+        explicit CompanionMap3DReadBack(CompanionMap3DRenderToTexture* owner)
+            : mOwner(owner)
+        {
+        }
+        void operator()(osg::RenderInfo& renderInfo) const override;
+        CompanionMap3DRenderToTexture* mOwner;
+    };
+
+    class CompanionMap3DRenderToTexture : public SceneUtil::RTTNode
+    {
+    public:
+        CompanionMap3DRenderToTexture(osg::Node* sceneRoot, int width, int height)
+            : RTTNode(width, height, 0, false, 0, StereoAwareness::Unaware, false)
+            , mSceneRoot(sceneRoot)
+            , mAspect(static_cast<double>(width) / height)
+            , mProjectionUniform(new osg::Uniform("projectionMatrix", osg::Matrixf()))
+        {
+            mProjectionUniform->setDataVariance(osg::Object::DYNAMIC);
+            setNodeMask(0);
+        }
+
+        /// Looks at a point on the ground from a distance, turned by a heading in degrees.
+        void setView(const osg::Vec3f& focus, float distance, float yawDegrees)
+        {
+            const double pitch = osg::DegreesToRadians(kPitch);
+            const double yaw = osg::DegreesToRadians(static_cast<double>(yawDegrees));
+            // Behind the focus along the heading, and up.
+            const osg::Vec3d back(-std::sin(yaw) * std::cos(pitch), -std::cos(yaw) * std::cos(pitch), std::sin(pitch));
+            const osg::Vec3d eye = osg::Vec3d(focus) + back * distance;
+            mViewMatrix.makeLookAt(eye, osg::Vec3d(focus), osg::Vec3d(0.0, 0.0, 1.0));
+
+            const double nearPlane = std::max(10.0, distance * 0.05);
+            const double farPlane = distance * 6.0 + 16384.0;
+            mPlainProjection.makePerspective(kFieldOfView, mAspect, nearPlane, farPlane);
+            mProjectionMatrix = SceneUtil::AutoDepth::isReversed()
+                ? SceneUtil::getReversedZProjectionMatrixAsPerspective(kFieldOfView, mAspect, nearPlane, farPlane)
+                : mPlainProjection;
+        }
+
+        osg::Matrixf getPlainViewProjection() const { return osg::Matrixf(mViewMatrix * mPlainProjection); }
+
+        void setDefaults(osg::Camera* camera) override
+        {
+            // Small feature culling off, as for the flat local map: from above, whole buildings can be
+            // a few pixels across when zoomed out, and a map must still show them.
+            camera->setCullingMode(
+                (osg::Camera::DEFAULT_CULLING | osg::Camera::FAR_PLANE_CULLING) & ~osg::Camera::SMALL_FEATURE_CULLING);
+            SceneUtil::setCameraClearDepth(camera);
+            camera->setComputeNearFarMode(osg::Camera::DO_NOT_COMPUTE_NEAR_FAR);
+            // The player's own view point picks the terrain and paged-object detail, so this camera
+            // reuses the pieces the game view already built instead of making a second set.
+            camera->setReferenceFrame(osg::Camera::ABSOLUTE_RF_INHERIT_VIEWPOINT);
+            camera->setRenderTargetImplementation(osg::Camera::FRAME_BUFFER_OBJECT, osg::Camera::PIXEL_BUFFER_RTT);
+            camera->setClearColor(osg::Vec4(0.03f, 0.03f, 0.04f, 1.f));
+            camera->setClearMask(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT);
+            camera->setRenderOrder(osg::Camera::PRE_RENDER);
+            const unsigned int mask = Mask_Scene | Mask_SimpleWater | Mask_Terrain | Mask_Object | Mask_Static;
+            camera->setCullMask(mask);
+            camera->setCullMaskLeft(mask);
+            camera->setCullMaskRight(mask);
+            camera->setNodeMask(Mask_RenderToTexture);
+
+            osg::StateSet* stateset = camera->getOrCreateStateSet();
+            stateset->setAttribute(new osg::PolygonMode(osg::PolygonMode::FRONT_AND_BACK, osg::PolygonMode::FILL),
+                osg::StateAttribute::OVERRIDE);
+            stateset->addUniform(mProjectionUniform, osg::StateAttribute::ON | osg::StateAttribute::OVERRIDE);
+
+            // No fog and no sky blending: the same overrides as the flat local map.
+            osg::ref_ptr<osg::Fog> fog(new osg::Fog);
+            fog->setStart(10000000);
+            fog->setEnd(10000000);
+            stateset->setAttributeAndModes(fog, osg::StateAttribute::OFF | osg::StateAttribute::OVERRIDE);
+            stateset->addUniform(new osg::Uniform("far", 10000000.0f));
+            stateset->addUniform(new osg::Uniform("skyBlendingStart", 8000000.0f));
+            stateset->addUniform(new osg::Uniform("screenRes", osg::Vec2f(static_cast<float>(width()),
+                                                                  static_cast<float>(height()))));
+
+            osg::ref_ptr<osg::LightModel> lightmodel = new osg::LightModel;
+            lightmodel->setAmbientIntensity(osg::Vec4(0.35f, 0.35f, 0.35f, 1.f));
+            stateset->setAttributeAndModes(lightmodel, osg::StateAttribute::ON | osg::StateAttribute::OVERRIDE);
+
+            osg::ref_ptr<osg::Light> light = new osg::Light;
+            light->setPosition(osg::Vec4(-0.3f, -0.3f, 0.7f, 0.f));
+            light->setDiffuse(osg::Vec4(0.75f, 0.75f, 0.75f, 1.f));
+            light->setAmbient(osg::Vec4(0, 0, 0, 1));
+            light->setSpecular(osg::Vec4(0, 0, 0, 0));
+            light->setLightNum(0);
+            light->setConstantAttenuation(1.f);
+            light->setLinearAttenuation(0.f);
+            light->setQuadraticAttenuation(0.f);
+
+            osg::ref_ptr<osg::LightSource> lightSource = new osg::LightSource;
+            lightSource->setLight(light);
+            lightSource->setStateSetModes(*stateset, osg::StateAttribute::ON | osg::StateAttribute::OVERRIDE);
+
+            SceneUtil::ShadowManager::instance().disableShadowsForStateSet(*stateset);
+            SceneUtil::configureStateSetSunOverride(static_cast<SceneUtil::LightManager*>(mSceneRoot.get()), light, stateset);
+
+            camera->addChild(lightSource);
+            camera->addChild(mSceneRoot);
+            camera->setPostDrawCallback(new CompanionMap3DReadBack(this));
+        }
+
+        void apply(osg::Camera* camera) override
+        {
+            camera->setViewMatrix(mViewMatrix);
+            camera->setProjectionMatrix(mProjectionMatrix);
+            mProjectionUniform->set(static_cast<osg::Matrixf>(mProjectionMatrix));
+        }
+
+        // Set on the engine thread before the frame that draws, read on the draw thread after it.
+        std::mutex mCaptureMutex;
+        bool mArmed = false;
+        Capture mCapture;
+
+    private:
+        osg::ref_ptr<osg::Node> mSceneRoot;
+        double mAspect;
+        osg::Matrixd mViewMatrix;
+        osg::Matrixd mProjectionMatrix;
+        osg::Matrixd mPlainProjection;
+        osg::ref_ptr<osg::Uniform> mProjectionUniform;
+    };
+
+    void CompanionMap3DReadBack::operator()(osg::RenderInfo& renderInfo) const
+    {
+        Capture capture;
+        {
+            std::lock_guard<std::mutex> lock(mOwner->mCaptureMutex);
+            if (!mOwner->mArmed)
+                return;
+            mOwner->mArmed = false;
+            capture = mOwner->mCapture;
+        }
+#ifdef __ANDROID__
+        osg::Texture* texture = mOwner->getColorTexture(nullptr);
+        osg::Texture::TextureObject* textureObject
+            = texture ? texture->getTextureObject(renderInfo.getState()->getContextID()) : nullptr;
+        if (textureObject == nullptr)
+        {
+            sInFlight.store(false);
+            return;
+        }
+        const int width = static_cast<int>(mOwner->width());
+        const int height = static_cast<int>(mOwner->height());
+
+        GLint previous = 0;
+        glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &previous);
+        GLuint fbo = 0;
+        glGenFramebuffers(1, &fbo);
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, fbo);
+        glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, textureObject->id(), 0);
+        if (glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE)
+        {
+            std::vector<unsigned char> raw(static_cast<size_t>(width) * height * 4);
+            glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, raw.data());
+            // GL rows run bottom-up; the companion wants them top-down.
+            std::vector<unsigned char> pixels(raw.size());
+            const size_t row = static_cast<size_t>(width) * 4;
+            for (int y = 0; y < height; ++y)
+                std::memcpy(pixels.data() + static_cast<size_t>(height - 1 - y) * row, raw.data() + y * row, row);
+            post(width, height, capture, pixels);
+        }
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, previous);
+        glDeleteFramebuffers(1, &fbo);
+#endif
+        sInFlight.store(false);
+    }
+}
+
+namespace
+{
+    osg::ref_ptr<MWRender::CompanionMap3DRenderToTexture> sNode;
+    osg::ref_ptr<osg::Group> sRoot;
+    int sNodeWidth = 0;
+    int sNodeHeight = 0;
+    bool sDrewLastFrame = false;
+    long long sLastRenderMs = 0;
+    long long sInFlightSinceMs = 0;
+    int sSequence = 0;
+
+    // What the last picture showed, to tell whether a new one is needed.
+    bool sLastValid = false;
+    osg::Vec3f sLastFocus;
+    float sLastDistance = 0.f;
+    float sLastYaw = 0.f;
+    const void* sLastCell = nullptr;
+
+    // A removed camera may still be drawing on the draw thread, and its read-back callback points at
+    // the node, so a removed node is kept alive for a while before it is let go.
+    struct Retired
+    {
+        osg::ref_ptr<MWRender::CompanionMap3DRenderToTexture> mNode;
+        long long mSinceMs;
+    };
+    std::vector<Retired> sRetired;
+
+    void purgeRetired(long long now)
+    {
+        sRetired.erase(std::remove_if(sRetired.begin(), sRetired.end(),
+                           [now](const Retired& r) { return now - r.mSinceMs > 2000; }),
+            sRetired.end());
+    }
+
+    void removeNode()
+    {
+        if (sNode && sRoot)
+        {
+            sNode->setNodeMask(0);
+            sRoot->removeChild(sNode);
+        }
+        if (sNode)
+            sRetired.push_back({ sNode, nowMs() });
+        sNode = nullptr;
+        sRoot = nullptr;
+        sNodeWidth = sNodeHeight = 0;
+        sDrewLastFrame = false;
+    }
+
+    bool ensureNode(MWRender::RenderingManager* rendering, int width, int height)
+    {
+        if (sNode && sNodeWidth == width && sNodeHeight == height)
+            return true;
+        removeNode();
+        osg::Group* root = rendering->getCompanionRootNode();
+        if (root == nullptr)
+            return false;
+        SceneUtil::FindByNameVisitor find("Scene Root");
+        root->accept(find);
+        if (find.mFoundNode == nullptr)
+            return false;
+        sNode = new MWRender::CompanionMap3DRenderToTexture(find.mFoundNode, width, height);
+        sRoot = root;
+        root->addChild(sNode);
+        sNodeWidth = width;
+        sNodeHeight = height;
+        sLastValid = false;
+        return true;
+    }
+
+    float parseFloat(const std::string& s, float fallback)
+    {
+        if (s.empty())
+            return fallback;
+        char* end = nullptr;
+        const float v = std::strtof(s.c_str(), &end);
+        return (end == s.c_str() || !std::isfinite(v)) ? fallback : v;
+    }
+}
