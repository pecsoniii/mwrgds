+// OpenMW-DS (RG DS): a 3D local map for the companion screen.
+//
+// The world around a point, seen from above at an angle, drawn into a texture by a camera of its own
+// and read back for the bottom screen, the same way companion-localmap-export reads the flat local
+// map. It draws the loaded cells only (the RG DS runs without distant terrain), with the flat local
+// map's fixed light and no fog, so the time of day and the weather don't change it.
+//
+// It draws on request, not every frame. The companion turns it on with the size of its picture and
+// a zoom, and the engine draws a new picture when the player has moved, the view or the cell has
+// changed, at most kMinIntervalMs apart. Each picture comes with the camera matrix that made it, so
+// the companion can place the player arrow and markers itself, at their live positions.
+//
+// Modelled on Modern Morrow's Map3D (github.com/DurhamG/modern-morrow, apps/openmw/mwrender/map3d.cpp,
+// GPLv3 like OpenMW): the camera's pitch, field of view, near/far planes and the picture-space maths
+// come from there. The drawing on request and the read-back are this port's own.
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <condition_variable>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <osg/Camera>
+#include <osg/Fog>
+#include <osg/Group>
+#include <osg/Light>
+#include <osg/LightModel>
+#include <osg/LightSource>
+#include <osg/PolygonMode>
+#include <osg/Texture2D>
+#include <osg/Uniform>
+
+#include <components/debug/debuglog.hpp>
+#include <components/sceneutil/depth.hpp>
+#include <components/sceneutil/lightmanager.hpp>
+#include <components/sceneutil/rtt.hpp>
+#include <components/sceneutil/shadow.hpp>
+#include <components/sceneutil/visitor.hpp>
+
+#include "../mwbase/environment.hpp"
+#include "../mwbase/statemanager.hpp"
+#include "../mwbase/world.hpp"
+#include "../mwworld/cellstore.hpp"
+#include "../mwworld/class.hpp"
